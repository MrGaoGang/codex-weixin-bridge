  "cards": [
    {
      "dot": "cyan",
      "title": "01 / Inbound and return path",
      "items": [
        "iLink long polling persists sync cursors and message IDs; failures retry with backoff.",
        "Authorized senders only. Media downloads to per-account inbound storage.",
        "Progress and final replies return through iLink; action blocks upload local files."
      ]
    },
    {
      "dot": "emerald",
      "title": "02 / Sessions and execution",
      "items": [
        "Web and WeChat continue the same managed Codex thread; model/effort can override globals.",
        "Auto backend falls back to exec; sandbox, approval and workspace rules reach both backends.",
        "Codex runs locally on the service host using that host\u2019s installed CLI and credentials."
      ]
    },
    {
      "dot": "rose",
      "title": "03 / Storage, access and updates",
      "items": [
        "State: accounts, credentials, runtime sessions, inbound files, config.json and logs.",
        "Bind loopback locally; explicit allowed hosts plus credentials for remote deployment.",
        "npm runtimes install, verify and restart with startup environment; source checkouts update manually."
      ]
    }
  ]
