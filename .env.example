# Copy to .env in the directory from which you launch codex-weixin.
# Existing process environment variables take precedence.
CODEX_WEIXIN_HOST=127.0.0.1
CODEX_WEIXIN_ALLOWED_HOSTS=127.0.0.1,localhost
CODEX_WEIXIN_PORT=8787
CODEX_WEIXIN_OPEN=0
# Recommended: uncomment BOTH credentials and replace the placeholder password.
# CODEX_WEIXIN_USERNAME=admin
# CODEX_WEIXIN_PASSWORD='replace-with-your-own-strong-password'
# Private state defaults to ~/.codex-weixin-bridge.
# CODEX_WEIXIN_STATE_DIR changes state storage only; set the Codex workspace in Web settings.
# Both use ~/.codex-weixin-bridge by default, but can be configured independently.
# A leading ~/ expands to the current user's home directory.
# CODEX_WEIXIN_STATE_DIR=/absolute/private/path
# Optional executable candidate if Codex is not found automatically.
# CHAT_CODEX_BIN=/usr/local/bin/codex

# Server example: replace these values, enable BOTH credentials above,
# use HTTPS and restrict the service port to trusted sources.
# CODEX_WEIXIN_HOST=0.0.0.0
# CODEX_WEIXIN_ALLOWED_HOSTS=203.0.113.10,bridge.example.com,192.168.1.10
# CODEX_WEIXIN_STATE_DIR=/srv/codex-weixin/state
